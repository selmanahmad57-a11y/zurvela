{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zurvela/config/publication",
  "type": "object",
  "additionalProperties": false,
  "required": ["octetsJeton", "expirationJetonMs", "fenetreValiditeMs", "prefixeFichier", "octetsScanId", "tailleCorpsMax", "port", "verificationGet", "proxy", "scan", "quota", "courriel", "webhook"],
  "properties": {
    "octetsJeton": { "type": "integer", "minimum": 16 },
    "expirationJetonMs": { "type": "integer", "minimum": 1 },
    "fenetreValiditeMs": { "type": "integer", "minimum": 1 },
    "prefixeFichier": { "type": "string", "minLength": 1 },
    "octetsScanId": { "type": "integer", "minimum": 16 },
    "tailleCorpsMax": { "type": "integer", "minimum": 1 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "verificationGet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delaiMs", "maxOctets"],
      "properties": { "delaiMs": { "type": "integer", "minimum": 1 }, "maxOctets": { "type": "integer", "minimum": 1 } }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delaiMs"],
      "properties": { "delaiMs": { "type": "integer", "minimum": 1 } }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs"],
      "properties": { "timeoutMs": { "type": "integer", "minimum": 1 } }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global", "parOrigine", "depenseMaxUsd", "parDestinataire"],
      "properties": {
        "global": { "type": "integer", "minimum": 1 },
        "parOrigine": { "type": "integer", "minimum": 1 },
        "depenseMaxUsd": { "type": "number", "exclusiveMinimum": 0 },
        "parDestinataire": { "type": "integer", "minimum": 1 }
      }
    },
    "courriel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expediteur", "replyTo", "delaiMs"],
      "properties": {
        "expediteur": { "type": "string", "minLength": 3 },
        "replyTo": { "type": "string", "minLength": 3 },
        "delaiMs": { "type": "integer", "minimum": 1 }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fenetreMs", "tauxBounceMax", "bounceMinAbsolu"],
      "properties": {
        "fenetreMs": {
          "type": "integer",
          "minimum": 172800000,
          "description": "Fenêtre glissante des stats de bounce/plainte ET de l'idempotence des webhooks. Plancher 2 j (IMPOSÉ ici) : elle doit rester ≥ l'horizon de retry de Svix, sinon une redelivery tardive serait recomptée. Défaut : 7 j (604800000)."
        },
        "tauxBounceMax": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "bounceMinAbsolu": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
