{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "zurvela/config/publication",
  "type": "object",
  "additionalProperties": false,
  "required": ["octetsJeton", "expirationJetonMs", "fenetreValiditeMs", "prefixeFichier", "octetsScanId", "tailleCorpsMax", "verificationGet", "proxy", "scan", "quota", "courriel"],
  "properties": {
    "octetsJeton": { "type": "integer", "minimum": 16 },
    "expirationJetonMs": { "type": "integer", "minimum": 1 },
    "fenetreValiditeMs": { "type": "integer", "minimum": 1 },
    "prefixeFichier": { "type": "string", "minLength": 1 },
    "octetsScanId": { "type": "integer", "minimum": 16 },
    "tailleCorpsMax": { "type": "integer", "minimum": 1 },
    "verificationGet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delaiMs", "maxOctets"],
      "properties": { "delaiMs": { "type": "integer", "minimum": 1 }, "maxOctets": { "type": "integer", "minimum": 1 } }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delaiMs"],
      "properties": { "delaiMs": { "type": "integer", "minimum": 1 } }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs"],
      "properties": { "timeoutMs": { "type": "integer", "minimum": 1 } }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global", "parOrigine", "depenseMaxUsd", "parDestinataire"],
      "properties": {
        "global": { "type": "integer", "minimum": 1 },
        "parOrigine": { "type": "integer", "minimum": 1 },
        "depenseMaxUsd": { "type": "number", "exclusiveMinimum": 0 },
        "parDestinataire": { "type": "integer", "minimum": 1 }
      }
    },
    "courriel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expediteur", "delaiMs"],
      "properties": {
        "expediteur": { "type": "string", "minLength": 3 },
        "delaiMs": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
