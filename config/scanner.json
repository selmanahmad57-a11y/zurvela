{
  "$schema": "./scanner.schema.json",
  "navigateur": {
    "canal": null,
    "sansTete": true
  },
  "robot": {
    "userAgent": "ZurvelaBot/0.1 (+https://zurvela.com)",
    "enTete": "X-Zurvela-Scan",
    "valeurEnTete": "1"
  },
  "viewports": [
    {
      "nom": "desktop",
      "largeur": 1280,
      "hauteur": 800,
      "mobile": false
    },
    {
      "nom": "mobile",
      "largeur": 390,
      "hauteur": 844,
      "mobile": true
    }
  ],
  "exploration": {
    "profondeurMax": 2,
    "pagesMax": 20,
    "chargementPageMs": 15000,
    "attenteEffetMaxMs": 8000,
    "stabilisationMs": 500,
    "clicMs": 2000,
    "saisieMs": 2000,
    "sondageMs": 50,
    "margeEcheanceMs": 5000,
    "evaluationMs": 15000,
    "mutationsMax": 5000,
    "bruitFondRepetitions": 2,
    "elementsInteractifsMax": 500,
    "liensParPageMax": 500,
    "politique": "deterministe",
    "libelleMaxChars": 120,
    "historiqueMaxActions": 10
  },
  "remplissage": {
    "regles": [
      {
        "types": [
          "email"
        ],
        "autocomplete": [
          "email"
        ],
        "valeur": "test@zurvela-scan.invalid"
      },
      {
        "types": [
          "tel"
        ],
        "autocomplete": [
          "tel",
          "tel-national"
        ],
        "valeur": "+33000000000"
      },
      {
        "types": [
          "url"
        ],
        "autocomplete": [
          "url"
        ],
        "valeur": "https://zurvela-scan.invalid"
      },
      {
        "types": [
          "number"
        ],
        "autocomplete": [],
        "valeur": "1"
      },
      {
        "types": [
          "date"
        ],
        "autocomplete": [
          "bday"
        ],
        "valeur": "2000-01-01"
      },
      {
        "types": [
          "password"
        ],
        "autocomplete": [
          "new-password",
          "current-password"
        ],
        "valeur": "Zurvela-scan-test-1!"
      },
      {
        "types": [],
        "autocomplete": [
          "given-name",
          "family-name",
          "name",
          "organization"
        ],
        "valeur": "Zurvela Scan Test"
      }
    ],
    "valeurTexteParDefaut": "Zurvela scan test",
    "typesIgnores": [
      "hidden",
      "submit",
      "button",
      "reset",
      "file",
      "image",
      "checkbox",
      "radio",
      "range",
      "color"
    ]
  },
  "detecteurs": {
    "http": {
      "confiance5xx": 0.9,
      "confiance404": 0.85,
      "gravite5xxSoumission": "bloquant",
      "gravite5xx": "important",
      "gravite404": "mineur",
      "categorieParTypeRessource": {
        "image": "visuel",
        "media": "visuel",
        "font": "visuel",
        "stylesheet": "visuel"
      },
      "categorieParDefaut": "fonctionnel",
      "confiance5xxSoumission": 0.95,
      "confianceDocumentInjoignable": 0.9,
      "graviteDocumentInjoignable": "bloquant",
      "erreursReseauIgnorees": [
        "net::ERR_ABORTED"
      ]
    },
    "inerte": {
      "confiance": 0.75,
      "gravite": "bloquant"
    },
    "echecMuet": {
      "confiance": 0.8,
      "gravite": "bloquant",
      "typesRequete": [
        "document",
        "xhr",
        "fetch"
      ]
    },
    "lenteur": {
      "seuilMs": 3000,
      "gravite": "important",
      "paliers": [
        {
          "ratioMin": 1,
          "confiance": 0.7
        },
        {
          "ratioMin": 1.5,
          "confiance": 0.85
        },
        {
          "ratioMin": 3,
          "confiance": 0.95
        }
      ]
    },
    "image": {
      "gravite": "mineur",
      "confianceSignalSimple": 0.8,
      "confianceSignalDouble": 0.95
    },
    "recouvrement": {
      "gravite": "bloquant",
      "confianceGeometrie": 0.8,
      "confianceGeometrieEtClic": 0.95
    }
  },
  "ia": {
    "variableCle": "ANTHROPIC_API_KEY",
    "variableWorkspace": "ANTHROPIC_WORKSPACE_ID",
    "reessaisReseauMax": 2,
    "modeles": {
      "profilage": "claude-haiku-4-5",
      "navigation": "claude-haiku-4-5",
      "diagnostic": "claude-opus-5",
      "redaction": "claude-opus-5"
    },
    "tarifs": {
      "claude-haiku-4-5": {
        "entreeParMillion": 1.0,
        "sortieParMillion": 5.0
      },
      "claude-opus-5": {
        "entreeParMillion": 5.0,
        "sortieParMillion": 25.0
      }
    }
  },
  "confirmation": {
    "politique": "complet",
    "seuilConfirmationDirecte": 0.9,
    "reExecutions": 2,
    "variations": [
      "contexte-neuf"
    ],
    "tauxReproduction": 1,
    "contreEpreuve": true,
    "agregationMesures": "mediane",
    "seuilRetenue": 0.6,
    "rejeu": {
      "chargementPageMs": 15000,
      "actionMs": 10000,
      "margeEcheanceMs": 3000,
      "budgetMinimalMs": 8000
    },
    "calibration": {
      "facteurVerdict": {
        "confirmee": 1.05,
        "intermittente": 0.85
      },
      "poidsTauxReproduction": 0.1,
      "bonusContreEpreuve": 0.05,
      "malusSymetrieInattendue": 0.25,
      "confianceMin": 0.05,
      "confianceMax": 0.99
    }
  }
}
