#!/bin/sh
# GATE pre-push — la suite complète doit être VERTE pour pousser.
#
# Pourquoi ce fichier existe (apprentissage n°56). Le commit 6a28926 a poussé un
# test rouge NON DÉTECTÉ, malgré la règle CONNUE « lance la suite avant de
# committer ». Une règle de méthode qui a cédé une fois ne se ré-énonce pas :
# elle se rend MÉCANIQUE (n°34 — un apprentissage inscrit n'est pas un réflexe
# installé ; n°28 — un invariant imposé par le code bat un invariant qu'un test
# vérifie). Sur un produit public, un rouge inaperçu peut être une FAILLE, pas
# juste un test — donc le gate n'est pas optionnel.
#
# Grain : pre-push, pas pre-commit — la suite fait ~270 s, trop lourde à chaque
# commit (on committe en petits morceaux) ; le push est le moment où le code
# quitte la machine vers origin, le bon point de contrôle.
#
# Échappatoire CONSCIENTE (urgence, décision assumée) : git push --no-verify.
# Le gate protège du RELÂCHEMENT (le vrai risque, prouvé par 6a28926), pas de la
# volonté de forcer. --no-verify existe : le gate n'est pas infranchissable, il
# est non-oubliable.
#
# ACTIVATION (une fois par clone) : git config core.hooksPath .githooks

echo "pre-push : typecheck + suite complète avant de pousser…"

if [ -s "$HOME/.nvm/nvm.sh" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1
fi

racine="$(git rev-parse --show-toplevel)" || exit 1
cd "$racine" || exit 1

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-push : pnpm introuvable — gate NON concluant, push REFUSÉ par prudence (fail-closed)." >&2
  echo "          corrige l'environnement, ou pousse en conscience : git push --no-verify" >&2
  exit 1
fi

# n°59 : une garde « tenue par le compilateur » (le `never` d'exhaustivité, les
# unions discriminées du contrat /scanner) n'est tenue AU GATE que si le gate lance
# le compilateur. Le gate ne lançait que `vitest run` → toute une classe d'invariants
# de type passait au push sans vérification. typecheck AVANT test : plus rapide, et il
# échoue plus tôt sur une classe d'erreurs plus fondamentale (inutile de lancer ~270 s
# de suite si le code ne type même pas). Échec de l'un OU l'autre = push refusé.
echo "pre-push 1/2 : pnpm typecheck…"
if ! pnpm typecheck; then
  echo "pre-push : typecheck ROUGE → push REFUSÉ (invariant de type violé — pas un flake)." >&2
  echo "          (contournement conscient : git push --no-verify)" >&2
  exit 1
fi
echo "pre-push 1/2 : typecheck VERT."
echo "pre-push 2/2 : pnpm test…"

# On CONSERVE la sortie complète dans un log : un rouge sous le gate (surtout un
# flake rare, qui ne se reproduit pas à la relance) doit laisser une trace
# diagnosticable — sinon on répare au hasard (apprentissage n°57 : un flake est
# une question ; encore faut-il pouvoir lire laquelle). `tee` garde le direct ;
# le `$?` du sous-shell donne le VRAI code de pnpm (le pipe masquerait celui de tee).
log="$(mktemp -t zurvela-gate.XXXXXX 2>/dev/null || echo "/tmp/zurvela-gate.$$")"
{ pnpm test 2>&1; echo "$?" >"$log.rc"; } | tee "$log"
status="$(cat "$log.rc" 2>/dev/null || echo 1)"
rm -f "$log.rc"

if [ "$status" -eq 0 ]; then
  echo "pre-push : typecheck + suite VERTS → push autorisé."
  rm -f "$log"
  exit 0
fi

echo "pre-push : suite ROUGE → push REFUSÉ. Détail COMPLET conservé : $log" >&2
echo "          (contournement conscient : git push --no-verify)" >&2
exit 1
