{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    // allowJs : `tsc` doit RÉSOUDRE l'import de la source unique `reessai.js`
    // (interface marchande) depuis les témoins .ts. Le type-check de ce .js est
    // porté par son `// @ts-check` interne (pas de checkJs global : la colle DOM
    // non typée de deploiement/ui/ n'est pas incluse et reste hors vérification).
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    "core/**/*.ts",
    "banc/**/*.ts",
    "prompts/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "deploiement/ui/reessai.js",
    "deploiement/ui/message-echec.js",
    "deploiement/ui/message-quota.js",
    "deploiement/ui/dispatch-scanner.js",
    "deploiement/ui/i18n.js"
  ]
}
