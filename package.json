{
  "name": "zurvela",
  "version": "0.1.0",
  "private": true,
  "description": "Zurvela — agent autonome de surveillance et de test d'applications web",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "banc": "tsx banc/correcteur/index.ts",
    "banc:servir": "tsx banc/serveur.ts",
    "banc:generer": "tsx banc/scenarios/generer.ts",
    "rapport:exemple": "tsx banc/rapport-exemple.ts",
    "scan": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=docs/.env.local --import tsx scripts/scan.ts",
    "banc:enregistrer-ia": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=docs/.env.local --import tsx banc/enregistrer-ia.ts",
    "banc:enregistrer-diagnostic": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=docs/.env.local --import tsx banc/enregistrer-diagnostic.ts",
    "banc:variance-ia": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --env-file-if-exists=docs/.env.local --import tsx banc/variance-ia.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.127.0",
    "ajv": "^8.20.0",
    "playwright": "1.61.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^5.0.1"
  }
}
